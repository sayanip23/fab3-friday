{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FRIDAY: run the app",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py", "--server.port", "8501"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "FRIDAY: run all verification gates",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/verify_submission.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONUTF8": "1" }
    },
    {
      "name": "FRIDAY: rebuild the source data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/generate_data.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONUTF8": "1" }
    }
  ]
}
